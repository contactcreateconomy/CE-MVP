# Copy to `.env.local` in this directory (gitignored).
#
# Development uses the LOCAL open-source Convex backend (`pnpm backend` from the
# repo root) — no Convex cloud account, no quota limits.

# --- Next.js (this app) — required ---
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Production (unchanged — Convex Cloud): NEXT_PUBLIC_CONVEX_URL=https://energetic-kangaroo-55.convex.cloud

# Member forum origin — "Back to the feed" from the admin console.
# This app does NOT use NEXT_PUBLIC_ADMIN_ORIGIN (that var is forum-only).
# Must be the FORUM host, never this console host.
NEXT_PUBLIC_FORUM_ORIGIN=http://localhost:3000
# Production: NEXT_PUBLIC_FORUM_ORIGIN=https://discuss.createconomy.com

# --- Convex deployment (NOT in this file) ---
# Backend env vars are set on the backend with `pnpm exec convex env set …`
# from the repo root. See ../../convex/.env.example and SETUP.md.
