# Copy to `.env.local` in this directory (gitignored).

# --- Next.js (this app) — required ---
NEXT_PUBLIC_CONVEX_URL=

# Example (local + Vercel Preview → Convex Development):
# NEXT_PUBLIC_CONVEX_URL=https://watchful-chameleon-570.convex.cloud
#
# Vercel Production → Convex Production:
# NEXT_PUBLIC_CONVEX_URL=https://energetic-kangaroo-55.convex.cloud

# Member forum origin — used for "Back to the feed" from the admin console.
NEXT_PUBLIC_FORUM_ORIGIN=http://localhost:3000

# --- Convex deployment (NOT in this file) ---
# OAuth secrets and SITE_URL live on Convex. See ../../convex/.env.example
# Staff Google sign-in on :3001 also needs AUTH_REDIRECT_ORIGINS to include
# http://localhost:3001 (set on the Convex deployment, not here).
