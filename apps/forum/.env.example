# Copy to `.env.local` in this directory (gitignored).
#
# Development uses the LOCAL open-source Convex backend (`pnpm backend` from the
# repo root) — no Convex cloud account, no quota limits. Every developer runs
# their own backend with their own database.

# --- Next.js (this app) — required ---
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Production (unchanged — Convex Cloud): NEXT_PUBLIC_CONVEX_URL=https://energetic-kangaroo-55.convex.cloud
# Production forum: https://discuss.createconomy.com/feed

# Staff console origin. Forum /admin/* redirects here.
# This app does NOT use NEXT_PUBLIC_FORUM_ORIGIN (that var is admin-only).
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
# Production: NEXT_PUBLIC_ADMIN_ORIGIN=https://console.createconomy.com

# --- Convex deployment (NOT in this file) ---
# Backend env vars (SITE_URL, AUTH_REDIRECT_ORIGINS, seeds, OAuth secrets) are
# set on the backend with `pnpm exec convex env set …` from the repo root.
# Template with all names: ../../convex/.env.example
# Full setup walkthrough (macOS + Windows): SETUP.md
