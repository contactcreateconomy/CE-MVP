# =============================================================================
# Convex deployment environment variables (backend / auth)
# =============================================================================
# Set these in the Convex Dashboard → Settings → Environment Variables, or from
# the monorepo root:
#   npx convex env set SITE_URL "http://localhost:3000"
#   npx convex env set AUTH_GOOGLE_ID "your-id.apps.googleusercontent.com"
#   npx convex env set AUTH_GOOGLE_SECRET "your-secret"
#
# Do NOT add OAuth secrets to Next.js apps — Auth.js callbacks run on Convex
# (HTTP Actions on your *.convex.site host).
#
# OAuth redirect / callback URLs (replace DEPLOYMENT with your Convex project):
#   https://DEPLOYMENT.convex.site/api/auth/callback/google
#   https://DEPLOYMENT.convex.site/api/auth/callback/github
#   https://DEPLOYMENT.convex.site/api/auth/callback/facebook
#
# Docs: https://labs.convex.dev/auth/setup/manual
# =============================================================================

# Present on dest AND prod dashboards (names only, verified 2026-09-16):
#   SITE_URL, AUTH_REDIRECT_ORIGINS, JWT_PRIVATE_KEY, JWKS,
#   AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET,
#   ADMIN_EMAILS
# Required for Google login + admin OAuth return: SITE_URL, AUTH_REDIRECT_ORIGINS,
# JWT_PRIVATE_KEY, JWKS, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET.
# GitHub pair is optional. Pipeline/Twilio/Facebook keys are unset (fail-closed / unused).

#   Development  dev/harinie           watchful-chameleon-570
#     Cloud: https://watchful-chameleon-570.convex.cloud
#     HTTP:  https://watchful-chameleon-570.convex.site
#   Production   production            energetic-kangaroo-55
#     Cloud: https://energetic-kangaroo-55.convex.cloud
#     HTTP:  https://energetic-kangaroo-55.convex.site
# OAuth callbacks: https://<slug>.convex.site/api/auth/callback/{google,github,facebook}

# App origin users return to after OAuth (no path). Examples:
#   http://localhost:3000
#   https://discuss.createconomy.com
SITE_URL=

# Optional: comma-separated app origins (e.g. https://seller.example.com,https://admin.example.com).
# OAuth / social sign-in passes redirectTo from the current page; Convex Auth only allows absolute
# URLs whose origin matches SITE_URL or one of these (see callbacks.redirect in convex/auth.ts).
AUTH_REDIRECT_ORIGINS=

# Issuer for JWTs; often set automatically on Convex Cloud. Used in convex/auth.config.ts
CONVEX_SITE_URL=

# Convex Auth — RS256 keypair. Docs: https://labs.convex.dev/auth/setup/manual
# 1) Copy this file to .env.local and fill other vars.
# 2) From repo root: `pnpm convex:gen-jwt` (updates JWT_PRIVATE_KEY + JWKS in convex/.env.local).
# 3) Sync to Convex: Dashboard → Environment Variables, or `pnpm exec convex env set …`
#    (use `convex env set JWT_PRIVATE_KEY --from-file <file>` — PEM can start with "-" and breaks argv).
JWT_PRIVATE_KEY=
JWKS=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (GitHub → Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Meta / Facebook OAuth (Meta for Developers → App → Settings)
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Optional: comma-separated founder emails (plus the documented
# contact.createconomy@gmail.com). Used to admit the founder when signup is
# closed and to auto-grant every staff role on login. Not an authz check.
# ADMIN_EMAILS=contact.createconomy@gmail.com
# FOUNDER_EMAILS=

# Optional: Twilio Verify — CAP-551 optional /setup mobile step only.
# Not required for signup, sign-in, comments, or posting. Leave unset until
# you want the optional SMS step live (then set on the Convex deployment).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=


# One-shot dev test user (convex/dev/ensureTestUser.ts): set to true, run
#   pnpm exec convex run dev/ensureTestUser:ensure
# then unset. Creates password login devtest@example.com (see that file for policy).
# ALLOW_DEV_TEST_USER=
