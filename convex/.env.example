# =============================================================================
# Convex backend environment variables (auth, seeds, integrations)
# =============================================================================
# Set these on the backend you are running against. In normal development that
# is the LOCAL open-source backend (`pnpm backend` from the repo root):
#   pnpm exec convex env set SITE_URL "http://localhost:3000"
#   pnpm exec convex env list
#
# Do NOT add OAuth secrets to Next.js apps — Auth.js callbacks run on Convex.
#
# OAuth redirect / callback URLs (only relevant when OAuth providers are
# configured and the backend is reachable from the internet; local dev uses
# password sign-in instead):
#   <backend-url>/api/auth/callback/google
#
# Docs: https://labs.convex.dev/auth/setup/manual
# =============================================================================

# Deployment topology:
#   Development → LOCAL open-source backend (`pnpm backend` from the repo root).
#   Production  → Convex Cloud production deployment (energetic-kangaroo-55), unchanged:
#     Cloud: https://energetic-kangaroo-55.convex.cloud
#     HTTP:  https://energetic-kangaroo-55.convex.site
# OAuth callbacks (prod only): https://energetic-kangaroo-55.convex.site/api/auth/callback/{google,github,facebook}

# Names currently consumed by convex/ (verified):
#   SITE_URL, AUTH_REDIRECT_ORIGINS, CONVEX_SITE_URL, FOUNDER_EMAILS,
#   ADMIN_EMAILS, DEMO_SEED_ENABLED, ALLOW_DEV_TEST_USER, DEV_TEST_USER_PASSWORD
# Optional/integration: JWT_PRIVATE_KEY, JWKS, AUTH_GOOGLE_ID/SECRET,
#   AUTH_GITHUB_ID/SECRET, AUTH_FACEBOOK_ID/SECRET, TWILIO_*, GLM_*,
#   MODERATION_CLASSIFIER_* (all fail closed while unset).
# Local dev needs only: SITE_URL, AUTH_REDIRECT_ORIGINS, FOUNDER_EMAILS,
#   and (one-shot) the seed/test-user flags documented at the bottom.

# App origin users return to (no path).
# Local dev: http://localhost:3000 · Production: https://discuss.createconomy.com
SITE_URL=http://localhost:3000

# Optional: comma-separated extra app origins (e.g. the admin console).
# Local dev: http://localhost:3000,http://localhost:3001
AUTH_REDIRECT_ORIGINS=

# Issuer for JWTs; often set automatically on Convex Cloud. Used in convex/auth.config.ts
CONVEX_SITE_URL=

# Convex Auth — RS256 keypair. Docs: https://labs.convex.dev/auth/setup/manual
# 1) Copy this file to .env.local and fill other vars.
# 2) From repo root: `pnpm convex:gen-jwt` (updates JWT_PRIVATE_KEY + JWKS in convex/.env.local).
# 3) Sync to Convex: Dashboard → Environment Variables, or `pnpm exec convex env set …`
#    (use `convex env set JWT_PRIVATE_KEY --from-file <file>` — PEM can start with "-" and breaks argv).
JWT_PRIVATE_KEY=
JWKS=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (GitHub → Settings → Developer settings → OAuth Apps)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Meta / Facebook OAuth (Meta for Developers → App → Settings)
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Optional: comma-separated founder emails (plus the documented
# contact.createconomy@gmail.com). Used to admit the founder when signup is
# closed and to auto-grant every staff role on login. Not an authz check.
# ADMIN_EMAILS=contact.createconomy@gmail.com
# FOUNDER_EMAILS=

# Optional: Twilio Verify — CAP-551 optional /setup mobile step only.
# Not required for signup, sign-in, comments, or posting. Leave unset until
# you want the optional SMS step live (then set on the Convex deployment).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=


# One-shot dev test user (convex/dev/ensureTestUser.ts): set to true, run
#   pnpm exec convex run dev/ensureTestUser:ensure
# then unset. Creates password login devtest@example.com (see that file for policy).
# ALLOW_DEV_TEST_USER=

# Dest-only visual fixtures (convex/dev/demoSeed.ts). NEVER set on production
# (energetic-kangaroo-55 / discuss.createconomy.com). Set true, run
#   pnpm exec convex run dev/demoSeed:seed
# then unset. Wipe with
#   pnpm exec convex run dev/demoSeed:wipe
# DEMO_SEED_ENABLED=

